package views

import "github.com/SoulStalker/chz-api-client/internal/model"

templ Certs(certs []model.Certificate) {
	@Layout("Сертификаты") {
		<h1 class="text-2xl font-bold mb-4">Сертификаты sign-service</h1>
		<table class="w-full bg-white shadow rounded">
			<thead class="bg-gray-100">
				<tr>
					<th class="px-4 py-2 text-left">Отпечаток</th>
					<th class="px-4 py-2 text-left">Субъект</th>
					<th class="px-4 py-2 text-left">Действует до</th>
					<th class="px-4 py-2 text-left">Действие</th>
				</tr>
			</thead>
			<tbody>
				for _, cert := range certs {
					<tr class="border-t">
						<td class="px-4 py-2 font-mono text-xs">{ cert.Thumbprint[:8] }...</td>
						<td class="px-4 py-2">{ cert.Subject }</td>
						<td class="px-4 py-2">{ cert.NotAfter }</td>
						<td class="px-4 py-2">
							<form method="POST" action="/auth">
								<input type="hidden" name="thumbprint" value={ cert.Thumbprint }/>
								<div class="flex gap-2">
									<input type="text" name="login" placeholder="Логин" class="border px-2 py-1 rounded text-sm" required/>
									<input type="password" name="password" placeholder="Пароль" class="border px-2 py-1 rounded text-sm" required/>
									<button type="submit" class="bg-blue-600 text-white px-3 py-1 rounded text-sm hover:bg-blue-700">Войти</button>
								</div>
							</form>
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}
