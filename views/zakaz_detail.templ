package views

import (
	"strconv"

	"github.com/SoulStalker/chz-api-client/internal/model"
)

templ ZakazDetail(zakaz *model.Zakaz, lines []model.ZakazLine, candidates []model.CandidateDoc, errMsg string) {
	@Layout("Заказ " + zakaz.Kod, "zakazy") {
		<nav class="text-sm text-gray-500 mb-4">
			<a href="/zakazy" class="hover:text-gray-700">Заказы WMS</a>
			<span class="mx-2">›</span>
			<span class="text-gray-900 font-medium">{ zakaz.Kod }</span>
		</nav>
		<div class="bg-white border border-gray-200 rounded-lg p-6 mb-6">
			<div class="grid grid-cols-2 gap-4 text-sm md:grid-cols-3">
				<div>
					<p class="text-xs text-gray-500 mb-0.5">Код заказа</p>
					<p class="font-mono font-medium text-gray-900">{ zakaz.Kod }</p>
				</div>
				<div>
					<p class="text-xs text-gray-500 mb-0.5">Номер</p>
					<p class="font-mono text-gray-700">{ zakaz.Nomer }</p>
				</div>
				<div>
					<p class="text-xs text-gray-500 mb-0.5">Дата заказа</p>
					<p class="text-gray-700">{ fmtZakazDate(zakaz.Data) }</p>
				</div>
				<div>
					<p class="text-xs text-gray-500 mb-0.5">Дата поставки</p>
					<p class="text-gray-700">{ fmtZakazDate(zakaz.DataPostavki) }</p>
				</div>
				<div>
					<p class="text-xs text-gray-500 mb-0.5">Поставщик</p>
					<p class="text-gray-900 font-medium">{ zakaz.PostImya }</p>
				</div>
				<div>
					<p class="text-xs text-gray-500 mb-0.5">ИНН поставщика</p>
					<p class="font-mono text-gray-700">{ zakaz.PostINN }</p>
				</div>
				<div>
					<p class="text-xs text-gray-500 mb-0.5">Накладная</p>
					<p class="font-mono text-gray-700">{ zakaz.NakladKod }</p>
				</div>
				<div>
					<p class="text-xs text-gray-500 mb-0.5">Сумма</p>
					<p class="font-mono text-gray-700">{ fmtSumma(zakaz.Summa) }</p>
				</div>
			</div>
		</div>
		<div class="mb-6">
			<h2 class="text-base font-semibold text-gray-900 mb-3">Привязка к CRPT-документу</h2>
			if zakaz.CRPTDocID != nil {
				<div class="bg-green-50 border border-green-200 rounded-lg p-4 flex items-center justify-between">
					<div>
						<p class="text-sm text-green-800 font-medium">Привязан к документу</p>
						<a href={ templ.SafeURL("/docs/" + *zakaz.CRPTDocID) } class="font-mono text-xs text-green-700 hover:text-green-900 underline">{ *zakaz.CRPTDocID }</a>
					</div>
					<form method="POST" action={ templ.SafeURL("/zakazy/" + zakaz.Kod + "/unmatch") }>
						<button type="submit" class="text-xs text-red-600 hover:text-red-800 border border-red-200 rounded px-3 py-1.5 hover:bg-red-50">Снять привязку</button>
					</form>
				</div>
			} else {
				if errMsg != "" {
					<div class="mb-3 bg-red-50 border border-red-200 rounded p-3">
						<p class="text-red-700 text-xs font-mono">{ errMsg }</p>
					</div>
				}
				if len(candidates) == 0 {
					<div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 text-sm text-yellow-800">
						Подходящих документов CRPT не найдено (ИНН: { zakaz.PostINN }, дата поставки: { fmtZakazDate(zakaz.DataPostavki) } ± 7 дней).
						Введите ID документа вручную ниже.
					</div>
				} else {
					<p class="text-xs text-gray-500 mb-2">Найдены документы CRPT с ИНН поставщика { zakaz.PostINN } около даты поставки:</p>
					<div class="bg-white border border-gray-200 rounded-lg overflow-hidden mb-4">
						<table class="w-full text-sm">
							<thead>
								<tr class="bg-gray-50 border-b border-gray-200">
									<th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Дата</th>
									<th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Счёт №</th>
									<th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Поставщик</th>
									<th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Статус</th>
									<th class="px-4 py-2"></th>
								</tr>
							</thead>
							<tbody>
								for _, doc := range candidates {
									<tr class="border-t border-gray-100 hover:bg-gray-50">
										<td class="px-4 py-2 whitespace-nowrap text-gray-700 text-xs">{ fmtDate(doc.DocDate) }</td>
										<td class="px-4 py-2 font-mono text-xs text-gray-700">{ doc.InvoiceNumber }</td>
										<td class="px-4 py-2 text-gray-900 text-xs">{ doc.SenderName }</td>
										<td class="px-4 py-2">@StatusBadge(doc.Status)</td>
										<td class="px-4 py-2 text-right">
											<form method="POST" action={ templ.SafeURL("/zakazy/" + zakaz.Kod + "/match") }>
												<input type="hidden" name="crpt_doc_id" value={ doc.Number }/>
												<button type="submit" class="text-xs bg-blue-600 text-white px-3 py-1 rounded hover:bg-blue-700">Привязать</button>
											</form>
										</td>
									</tr>
									if len(doc.Products) > 0 {
										<tr class="border-t border-gray-100 bg-gray-50">
											<td colspan="5" class="px-4 pb-3 pt-0">
												<details>
													<summary class="cursor-pointer text-xs text-gray-400 hover:text-gray-600 select-none py-1">
														{ strconv.Itoa(len(doc.Products)) } позиций в документе
													</summary>
													<table class="mt-2 w-full text-xs border border-gray-200 rounded">
														<thead>
															<tr class="bg-white border-b border-gray-200">
																<th class="px-3 py-1.5 text-left text-gray-400 font-semibold uppercase tracking-wide">GTIN</th>
																<th class="px-3 py-1.5 text-left text-gray-400 font-semibold uppercase tracking-wide">Наименование</th>
																<th class="px-3 py-1.5 text-right text-gray-400 font-semibold uppercase tracking-wide">Кол-во</th>
															</tr>
														</thead>
														<tbody class="divide-y divide-gray-100">
															for _, p := range doc.Products {
																<tr>
																	<td class="px-3 py-1 font-mono text-gray-600">{ p.GTIN }</td>
																	<td class="px-3 py-1 text-gray-800">{ p.Name }</td>
																	<td class="px-3 py-1 text-right font-mono text-gray-600">{ p.Quantity }</td>
																</tr>
															}
														</tbody>
													</table>
												</details>
											</td>
										</tr>
									}
								}
							</tbody>
						</table>
					</div>
				}
				<div class="mt-3">
					<p class="text-xs text-gray-500 mb-2">Или введите ID документа CRPT вручную:</p>
					<form method="POST" action={ templ.SafeURL("/zakazy/" + zakaz.Kod + "/match") } class="flex gap-2">
						<input type="text" name="crpt_doc_id" placeholder="ID документа CRPT" class="border border-gray-300 rounded px-3 py-1.5 text-sm font-mono flex-1 focus:outline-none focus:border-blue-400"/>
						<button type="submit" class="bg-blue-600 text-white px-4 py-1.5 rounded text-sm hover:bg-blue-700">Привязать</button>
					</form>
				</div>
			}
		</div>
		if len(lines) > 0 {
			<h2 class="text-base font-semibold text-gray-900 mb-3">Строки заказа</h2>
			<div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
				<table class="w-full text-sm">
					<thead>
						<tr class="bg-gray-50 border-b border-gray-200">
							<th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Код товара</th>
							<th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">ШК</th>
							<th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Наименование</th>
							<th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wide">Кол-во</th>
							<th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wide">Сумма</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-gray-100">
						for _, l := range lines {
							<tr class="hover:bg-gray-50">
								<td class="px-5 py-3 font-mono text-xs text-gray-700">{ l.TovarKod }</td>
								<td class="px-5 py-3 font-mono text-xs text-gray-500">{ l.SHK }</td>
								<td class="px-5 py-3 text-gray-900">{ l.Naim }</td>
								<td class="px-5 py-3 text-right font-mono text-xs text-gray-700">{ fmtSumma(l.Kolvo) }</td>
								<td class="px-5 py-3 text-right font-mono text-xs text-gray-700">{ fmtSumma(l.Summa) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}
