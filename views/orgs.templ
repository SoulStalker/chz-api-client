package views

import "github.com/SoulStalker/chz-api-client/internal/model"

templ Orgs(orgs []model.Organization) {
	@Layout("Организации") {
		<h1 class="text-2xl font-bold mb-4">Выберите организацию</h1>
		<table class="w-full bg-white shadow rounded">
			<thead class="bg-gray-100">
				<tr>
					<th class="px-4 py-2 text-left">Название</th>
					<th class="px-4 py-2 text-left">ИНН</th>
					<th class="px-4 py-2 text-left">BoxId</th>
					<th class="px-4 py-2 text-left">Действие</th>
				</tr>
			</thead>
			<tbody>
				for _, org := range orgs {
					<tr class="border-t">
						<td class="px-4 py-2">{ org.Name }</td>
						<td class="px-4 py-2">{ org.Inn }</td>
						<td class="px-4 py-2 font-mono text-xs">{ org.BoxId }</td>
						<td class="px-4 py-2">
							<form method="POST" action="/orgs/select">
								<input type="hidden" name="box_id" value={ org.BoxId }/>
								<button type="submit" class="bg-green-600 text-white px-3 py-1 rounded text-sm hover:bg-green-700">Выбрать</button>
							</form>
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}
