package views

import (
	"fmt"
	"net/url"
	"strconv"
	"time"

	"github.com/SoulStalker/chz-api-client/internal/model"
)

func fmtDate(iso string) string {
	for _, layout := range []string{
		"2006-01-02T15:04:05.000Z",
		"2006-01-02T15:04:05Z",
		"2006-01-02",
	} {
		if t, err := time.Parse(layout, iso); err == nil {
			return t.Format("02.01.2006")
		}
	}
	return iso
}

func docTypeLabel(t string) string {
	switch t {
	case "LP_SHIP_GOODS", "LP_SHIP_GOODS_CSV", "LP_SHIP_GOODS_XML":
		return "Отгрузка"
	case "UNIVERSAL_TRANSFER_DOCUMENT":
		return "УПД"
	case "LP_ACCEPT_GOODS":
		return "Приёмка"
	default:
		return t
	}
}

func paginationHref(isIncoming bool, dateFrom, dateTo, did, ocv string) string {
	dir := "outgoing"
	if isIncoming {
		dir = "incoming"
	}
	return fmt.Sprintf("/docs/%s?date_from=%s&date_to=%s&did=%s&ordered_column_value=%s",
		dir, url.QueryEscape(dateFrom), url.QueryEscape(dateTo), url.QueryEscape(did), url.QueryEscape(ocv))
}

func routeForDir(isIncoming bool) string {
	if isIncoming {
		return "/docs/incoming"
	}
	return "/docs/outgoing"
}

templ StatusBadge(s string) {
	switch s {
	case "CHECKED_OK":
		<span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Проверено</span>
	case "WAIT_ACCEPTANCE":
		<span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">Ожидает приёмки</span>
	case "REJECTED", "CHECKED_NOT_OK":
		<span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Отклонено</span>
	case "ACCEPTED":
		<span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Принято</span>
	case "CANCELLED":
		<span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium bg-gray-200 text-gray-600">Отменено</span>
	case "IN_PROGRESS":
		<span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">В обработке</span>
	default:
		<span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">{ s }</span>
	}
}

templ Documents(docs []model.Document, nextPage bool, errMsg string, isIncoming bool, dateFrom string, dateTo string, nextDID string, nextOCV string) {
	@Layout("Документы", "docs") {
		<div class="flex gap-6 border-b border-gray-200 mb-6">
			if isIncoming {
				<a href="/docs/incoming" class="pb-2 text-sm font-medium border-b-2 border-blue-600 text-blue-600">Входящие</a>
				<a href="/docs/outgoing" class="pb-2 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700">Исходящие</a>
			} else {
				<a href="/docs/incoming" class="pb-2 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700">Входящие</a>
				<a href="/docs/outgoing" class="pb-2 text-sm font-medium border-b-2 border-blue-600 text-blue-600">Исходящие</a>
			}
		</div>
		<form method="GET" action={ templ.SafeURL(routeForDir(isIncoming)) } class="mb-6 flex gap-3 items-end">
			<div>
				<label class="block text-xs text-gray-500 mb-1">Дата от</label>
				<input type="date" name="date_from" value={ dateFrom } class="border border-gray-300 rounded px-3 py-1.5 text-sm focus:outline-none focus:border-blue-400"/>
			</div>
			<div>
				<label class="block text-xs text-gray-500 mb-1">Дата до</label>
				<input type="date" name="date_to" value={ dateTo } class="border border-gray-300 rounded px-3 py-1.5 text-sm focus:outline-none focus:border-blue-400"/>
			</div>
			<button type="submit" class="bg-blue-600 text-white px-4 py-1.5 rounded text-sm hover:bg-blue-700">Применить</button>
		</form>
		if errMsg != "" {
			<div class="mb-6 bg-red-50 border border-red-200 rounded-lg p-4">
				<p class="text-red-700 font-medium text-sm">Ошибка загрузки документов</p>
				<p class="text-red-600 text-xs mt-1 font-mono">{ errMsg }</p>
			</div>
		}
		if docs != nil {
			if len(docs) == 0 {
				<div class="bg-white border border-gray-200 rounded-lg p-12 text-center">
					<p class="text-gray-400 text-sm">Документов не найдено</p>
				</div>
			} else {
				<div class="flex items-center justify-between mb-3">
					<span class="text-sm text-gray-500">Показано: { strconv.Itoa(len(docs)) }</span>
				</div>
				<div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
					<table class="w-full text-sm">
						<thead>
							<tr class="bg-gray-50 border-b border-gray-200">
								<th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Дата</th>
								<th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Счёт №</th>
								<th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Поставщик</th>
								<th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">ИНН</th>
								<th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Тип</th>
								<th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Статус</th>
								<th class="px-5 py-3"></th>
							</tr>
						</thead>
						<tbody class="divide-y divide-gray-100">
							for _, doc := range docs {
								<tr class="hover:bg-gray-50 transition-colors">
									<td class="px-5 py-3 whitespace-nowrap text-gray-700">{ fmtDate(doc.DocDate) }</td>
									<td class="px-5 py-3 text-gray-700 font-mono text-xs">{ doc.InvoiceNumber }</td>
									<td class="px-5 py-3 text-gray-900 font-medium">{ doc.SenderName }</td>
									<td class="px-5 py-3 font-mono text-xs text-gray-500">{ doc.SenderInn }</td>
									<td class="px-5 py-3 text-gray-600">{ docTypeLabel(doc.Type) }</td>
									<td class="px-5 py-3">@StatusBadge(doc.Status)</td>
									<td class="px-5 py-3 text-right">
										<a href={ templ.SafeURL("/docs/" + doc.Number) } class="text-blue-600 hover:text-blue-800 text-xs font-medium">Детали →</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				if nextPage {
					<div class="mt-4 text-center">
						<a href={ templ.SafeURL(paginationHref(isIncoming, dateFrom, dateTo, nextDID, nextOCV)) } class="inline-block bg-white border border-gray-300 text-gray-700 px-5 py-2 rounded text-sm hover:bg-gray-50">Следующая страница →</a>
					</div>
				}
			}
		}
	}
}
