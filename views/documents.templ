package views

import (
	"github.com/SoulStalker/chz-api-client/internal/model"
)

var statusLabels = map[string]string{
	"WAIT_ACCEPTANCE": "Ожидает приёмки",
	"ACCEPTED":        "Принято",
	"REJECTED":        "Отклонено",
	"CANCELLED":       "Отменено",
}

func statusLabel(s string) string {
	if l, ok := statusLabels[s]; ok {
		return l
	}
	return s
}

templ Documents(docs []model.Document, nextPage bool, errMsg string) {
	@Layout("Входящие документы") {
		<h1 class="text-2xl font-bold mb-4">Входящие документы</h1>
		if errMsg != "" {
			<div class="mb-4 bg-red-50 border border-red-300 rounded p-4">
				<p class="text-red-700 font-medium">Ошибка загрузки документов</p>
				<p class="text-red-600 text-sm mt-1 font-mono">{ errMsg }</p>
			</div>
		}
		if docs != nil {
			if len(docs) == 0 {
				<div class="bg-white shadow rounded p-8 text-center text-gray-500">
					Документов не найдено
				</div>
			} else {
				<div class="overflow-x-auto">
					<table class="w-full bg-white shadow rounded text-sm">
						<thead class="bg-gray-100">
							<tr>
								<th class="px-4 py-2 text-left">Номер</th>
								<th class="px-4 py-2 text-left">Тип</th>
								<th class="px-4 py-2 text-left">Дата</th>
								<th class="px-4 py-2 text-left">ИНН отправителя</th>
								<th class="px-4 py-2 text-left">Статус</th>
								<th class="px-4 py-2 text-left">Детали</th>
							</tr>
						</thead>
						<tbody>
							for _, doc := range docs {
								<tr class="border-t hover:bg-gray-50">
									<td class="px-4 py-2 font-mono text-xs">{ doc.Number }</td>
									<td class="px-4 py-2 font-mono text-xs">{ doc.Type }</td>
									<td class="px-4 py-2 whitespace-nowrap">{ doc.DocDate }</td>
									<td class="px-4 py-2 font-mono text-xs">{ doc.SenderInn }</td>
									<td class="px-4 py-2">{ statusLabel(doc.Status) }</td>
									<td class="px-4 py-2">
										<a href={ templ.SafeURL("/docs/" + doc.Number) } class="text-blue-600 hover:underline text-xs">Детали</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		}
	}
}
