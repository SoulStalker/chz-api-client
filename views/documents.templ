package views

import "github.com/SoulStalker/chz-api-client/internal/model"

templ Documents(docs []model.Document, boxId string) {
	@Layout("Входящие документы") {
		<h1 class="text-2xl font-bold mb-4">Входящие документы</h1>
		<p class="text-sm text-gray-500 mb-4">BoxId: { boxId }</p>
		<table class="w-full bg-white shadow rounded">
			<thead class="bg-gray-100">
				<tr>
					<th class="px-4 py-2 text-left">Номер</th>
					<th class="px-4 py-2 text-left">Дата</th>
					<th class="px-4 py-2 text-left">Контрагент</th>
					<th class="px-4 py-2 text-left">Статус</th>
					<th class="px-4 py-2 text-left">КМ</th>
					<th class="px-4 py-2 text-left"></th>
				</tr>
			</thead>
			<tbody>
				for _, doc := range docs {
					<tr class="border-t hover:bg-gray-50">
						<td class="px-4 py-2">{ doc.DocumentNumber }</td>
						<td class="px-4 py-2">{ doc.DocumentDate }</td>
						<td class="px-4 py-2">{ doc.CounteragentName }</td>
						<td class="px-4 py-2">{ doc.Status }</td>
						<td class="px-4 py-2">
							if doc.HasMarkingCodes {
								<span class="text-green-600">✓</span>
							}
						</td>
						<td class="px-4 py-2">
							<a href={ templ.SafeURL("/docs/" + doc.MessageId + "?entity_id=" + doc.EntityId) } class="text-blue-600 hover:underline">Открыть</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}
