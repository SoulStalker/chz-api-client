package views

import (
	"encoding/json"
	"net/url"
	"strconv"

	"github.com/SoulStalker/chz-api-client/internal/model"
)

func docTitle(doc *model.DocInfo) string {
	if doc.InvoiceNumber != "" {
		return doc.InvoiceNumber
	}
	return doc.Number
}

func senderDisplay(doc *model.DocInfo) string {
	if doc.SenderName != "" {
		return doc.SenderName
	}
	return doc.SenderInn
}

func relatedDocStr(id *string) string {
	if id == nil {
		return "—"
	}
	return *id
}

func docJSON(doc *model.DocInfo) string {
	b, _ := json.MarshalIndent(doc, "", "  ")
	return string(b)
}

// isAggregate возвращает true если код является контейнером (нужен drill-down).
// EXEMPLARY с quantity > 1 — это КИТУ/КИГУ, несмотря на то что CRPT API возвращает codeType "EXEMPLARY".
func isAggregate(codeType, quantity string) bool {
	switch codeType {
	case "BOX", "GROUP":
		return true
	case "EXEMPLARY":
		q, err := strconv.Atoi(quantity)
		return err == nil && q > 1
	}
	return false
}

func packTypeLabel(codeType, quantity string) string {
	switch codeType {
	case "BOX":
		return "Транспортная упаковка"
	case "GROUP":
		return "Групповая упаковка"
	case "EXEMPLARY":
		if isAggregate(codeType, quantity) {
			return "Транспортная упаковка"
		}
		return "Единица товара"
	case "UNIT", "OSU":
		return "Единица товара"
	default:
		return codeType
	}
}

func packHref(docID, code, invoiceNumber string) string {
	return "/docs/" + docID + "/pack/" + code + "?invoice_number=" + url.QueryEscape(invoiceNumber)
}

func docsBackHref(fromDir string) string {
	if fromDir == "outgoing" {
		return "/docs/outgoing"
	}
	return "/docs/incoming"
}

func quantityLabel(q string) string {
	if q == "" {
		return "?"
	}
	return q
}

templ DocumentDetail(docID string, doc *model.DocInfo, errMsg string, fromDir string) {
	@Layout("Документ", "docs") {
		<div class="mb-6">
			<a href={ templ.SafeURL(docsBackHref(fromDir)) } class="text-blue-600 hover:text-blue-800 text-sm font-medium">← Документы</a>
		</div>
		if errMsg != "" {
			<div class="mb-6 bg-red-50 border border-red-200 rounded-lg p-4">
				<p class="text-red-700 font-medium text-sm">Ошибка загрузки документа</p>
				<p class="text-red-600 text-xs mt-1 font-mono">{ errMsg }</p>
			</div>
		}
		if doc != nil {
			<div class="bg-white border border-gray-200 rounded-lg p-6 mb-6">
				<div class="flex items-start justify-between mb-4">
					<div>
						<h1 class="text-2xl font-bold text-gray-900">{ docTitle(doc) }</h1>
						<p class="text-gray-500 mt-1">{ senderDisplay(doc) }</p>
					</div>
					<div class="mt-1">
						@StatusBadge(doc.Status)
					</div>
				</div>
				<dl class="grid grid-cols-2 md:grid-cols-3 gap-x-6 gap-y-4 text-sm border-t border-gray-100 pt-4">
					<div>
						<dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Дата документа</dt>
						<dd class="text-gray-900">{ fmtDate(doc.DocDate) }</dd>
					</div>
					<div>
						<dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Поставщик</dt>
						<dd class="text-gray-900">{ doc.SenderName }</dd>
						<dd class="font-mono text-xs text-gray-500 mt-0.5">{ doc.SenderInn }</dd>
					</div>
					<div>
						<dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Получатель</dt>
						<dd class="text-gray-900">{ doc.ReceiverName }</dd>
						<dd class="font-mono text-xs text-gray-500 mt-0.5">{ doc.ReceiverInn }</dd>
					</div>
				</dl>
				<details class="mt-4 border-t border-gray-100 pt-3">
					<summary class="text-xs text-gray-400 cursor-pointer hover:text-gray-500 select-none">Debug</summary>
					<dl class="mt-2 text-xs text-gray-500 font-mono space-y-1">
						<div><span class="text-gray-400">number:</span> { doc.Number }</div>
						<div><span class="text-gray-400">receivedAt:</span> { doc.ReceivedAt }</div>
						<div><span class="text-gray-400">relatedDocId:</span> { relatedDocStr(doc.RelatedDocID) }</div>
						<div><span class="text-gray-400">turnoverType:</span> { doc.TurnoverType }</div>
					</dl>
					<pre class="mt-3 text-xs text-gray-500 bg-gray-50 rounded p-3 overflow-x-auto">{ docJSON(doc) }</pre>
				</details>
			</div>
			<div class="border-b border-gray-200 mb-6">
				<div class="flex gap-4">
					<button
						onclick="showDocTab('codes')"
						id="btn-codes"
						class="pb-2 text-sm font-medium border-b-2 border-blue-600 text-blue-600"
					>Коды</button>
					<button
						onclick="showDocTab('info')"
						id="btn-info"
						class="pb-2 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700"
					>Расширенная информация</button>
				</div>
			</div>
			<div id="tab-codes">
				if len(doc.Body.Products) > 0 {
					<div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
						<div class="px-5 py-3 bg-gray-50 border-b border-gray-200">
							<span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">{ strconv.Itoa(len(doc.Body.Products)) } позиций</span>
						</div>
						<table class="w-full text-sm">
							<thead>
								<tr class="border-b border-gray-200">
									<th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Код</th>
									<th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">GTIN</th>
									<th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Наименование</th>
									<th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Тип упаковки</th>
									<th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Содержит</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-gray-100">
								for _, p := range doc.Body.Products {
									<tr class="hover:bg-gray-50">
										<td class="px-5 py-3"><code class="font-mono text-xs text-gray-700 break-all">{ p.Code }</code></td>
										<td class="px-5 py-3 font-mono text-xs text-gray-500">{ p.GTIN }</td>
										<td class="px-5 py-3 text-gray-800 text-xs">{ p.Name }</td>
										<td class="px-5 py-3 text-xs text-gray-500">{ packTypeLabel(p.CodeType, p.Quantity) }</td>
										<td class="px-5 py-3">
											if isAggregate(p.CodeType, p.Quantity) {
												<a href={ templ.SafeURL(packHref(docID, p.Code, docTitle(doc))) } class="text-blue-600 hover:text-blue-800 text-xs font-medium">[{ quantityLabel(p.Quantity) }] вложений →</a>
											} else {
												<span class="text-gray-300">—</span>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				} else if len(doc.Body.CisesList) > 0 {
					<div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
						<div class="px-5 py-3 bg-gray-50 border-b border-gray-200">
							<span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">{ strconv.Itoa(len(doc.Body.CisesList)) } КИ</span>
						</div>
						<table class="w-full text-sm">
							<thead>
								<tr class="border-b border-gray-200">
									<th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide">Код маркировки</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-gray-100">
								for _, cis := range doc.Body.CisesList {
									<tr class="hover:bg-gray-50">
										<td class="px-5 py-3"><code class="font-mono text-xs text-gray-700 break-all">{ cis }</code></td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				} else {
					<div class="bg-white border border-gray-200 rounded-lg p-12 text-center">
						<p class="text-gray-400 text-sm">Позиций не найдено</p>
					</div>
				}
			</div>
			<div id="tab-info" class="hidden">
				<div class="bg-white border border-gray-200 rounded-lg p-6">
					<dl class="grid grid-cols-2 md:grid-cols-3 gap-x-6 gap-y-5 text-sm">
						if doc.Body.UPD != "" {
							<div>
								<dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Номер УПД</dt>
								<dd class="text-gray-900 font-mono">{ doc.Body.UPD }</dd>
							</div>
						}
						if doc.Body.UPDDate != "" {
							<div>
								<dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Дата УПД</dt>
								<dd class="text-gray-900">{ fmtDate(doc.Body.UPDDate) }</dd>
							</div>
						}
						if doc.Body.AcceptanceCode != "" {
							<div>
								<dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Код приёмки</dt>
								<dd class="text-gray-900 font-mono">{ doc.Body.AcceptanceCode }</dd>
							</div>
						}
						if doc.Body.SumNds != "" {
							<div>
								<dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Сумма НДС</dt>
								<dd class="text-gray-900">{ doc.Body.SumNds }</dd>
							</div>
						}
						if doc.TurnoverType != "" {
							<div>
								<dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Вид оборота</dt>
								<dd class="text-gray-900">{ doc.TurnoverType }</dd>
							</div>
						}
						<div>
							<dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Поставщик</dt>
							<dd class="text-gray-900">{ doc.SenderName }</dd>
							<dd class="font-mono text-xs text-gray-500">{ doc.SenderInn }</dd>
						</div>
						<div>
							<dt class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-1">Получатель</dt>
							<dd class="text-gray-900">{ doc.ReceiverName }</dd>
							<dd class="font-mono text-xs text-gray-500">{ doc.ReceiverInn }</dd>
						</div>
					</dl>
				</div>
			</div>
			<script>
				function showDocTab(name) {
					document.getElementById('tab-codes').classList.toggle('hidden', name !== 'codes');
					document.getElementById('tab-info').classList.toggle('hidden', name !== 'info');
					var active = 'pb-2 text-sm font-medium border-b-2 border-blue-600 text-blue-600';
					var inactive = 'pb-2 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700';
					document.getElementById('btn-codes').className = name === 'codes' ? active : inactive;
					document.getElementById('btn-info').className = name === 'info' ? active : inactive;
				}
			</script>
		}
	}
}
